# Database
DATABASE_URL="postgresql://pricewatch:pricewatch@localhost:5432/pricewatch?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API
API_PORT=3000
NODE_ENV="development"
JWT_SECRET="your-secret-key-change-in-production"

# Price Providers (Mock is used by default in development)
PRICE_PROVIDER="mock"

# Amazon Creators API (successor to PA-API 5.0)
# Obtain credentials from: https://creators.amazon.in/
# NOTE: Prices may vary by delivery location
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
AMAZON_REGION="in"

# Flipkart Affiliate API
# Obtain credentials from: https://affiliate.flipkart.com/
# 1. Sign up for Flipkart Affiliate Program
# 2. Navigate to API section in dashboard
# 3. Generate API credentials (Affiliate ID and Token)
# API Base URL: https://affiliate-api.flipkart.net/affiliate
# Endpoints: GET /product/json?id={productId}
# Headers required: Fk-Affiliate-Id, Fk-Affiliate-Token
# Rate limit: ~10 requests per minute (adjust RATE_LIMIT_FLIPKART if needed)
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

# Firebase Cloud Messaging (for push notifications)
# Get from Firebase Console -> Project Settings -> Service Accounts
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

# Notification fallback (console logs when FCM not configured)
NOTIFICATION_FALLBACK="console"

# Scheduler settings
SCHEDULER_TICK_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=100

# Alert cooldown (hours)
ALERT_COOLDOWN_HOURS=24
ALERT_DROP_THRESHOLD_PERCENT=5

# Rate limiting (requests per minute per retailer)
RATE_LIMIT_AMAZON=10
RATE_LIMIT_FLIPKART=10

# Worker concurrency
WORKER_CONCURRENCY=5
