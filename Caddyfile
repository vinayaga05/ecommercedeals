:80 {
	handle /api/* {
		reverse_proxy api:3000
	}

	handle /* {
		reverse_proxy web:3001
	}

	log {
		output stdout
		format console
	}
}

# For production with domain:
# your-domain.com {
#     handle /api/* {
#         reverse_proxy api:3000
#     }
#
#     handle /* {
#         reverse_proxy web:3001
#     }
#
#     tls your-email@example.com
#
#     log {
#         output file /var/log/caddy/access.log
#     }
# }
